# ── Servidor ──
PORT=3000
BASE_URL=https://tudominio.com

# ── Base de datos (PostgreSQL) ──
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://labshorturl:labshorturl@localhost:5432/labshorturl

# ── Admin ──
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contrasena-en-produccion

# ── Sesión ──
# Genera un secreto aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-en-produccion

# ── Monitoreo de errores (Sentry) ──
# Opcional. Obtén tu DSN en https://sentry.io → Settings → Projects → Client Keys
# Deja vacío para desactivar
SENTRY_DSN=

# ── Entorno ──
# En producción (detrás de HTTPS/nginx) cambia a: production
# Esto activa: cookie segura, trust proxy para rate limiting correcto
NODE_ENV=development
