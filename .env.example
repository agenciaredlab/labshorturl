# ── Servidor ──
PORT=3000
BASE_URL=https://tudominio.com

# ── Base de datos (PostgreSQL) ──
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://labshorturl:labshorturl@localhost:5432/labshorturl

# ── Admin ──
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-contrasena-en-produccion

# ── Super Admin (panel de estadísticas globales) ──
# PIN adicional exclusivo para /superadmin. Recomendado en producción.
# Si se deja vacío, el panel es accesible con la sesión de admin normal.
# Genera uno: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SUPERADMIN_PASS=

# ── Sesión ──
# Genera un secreto aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-en-produccion

# ── Monitoreo de errores (Sentry) ──
# Opcional. Obtén tu DSN en https://sentry.io → Settings → Projects → Client Keys
# Deja vacío para desactivar
SENTRY_DSN=

# ── Entorno ──
# En producción (detrás de HTTPS/nginx) cambia a: production
# Esto activa: cookie segura, trust proxy para rate limiting correcto
NODE_ENV=development

# ── Pagos — Stripe ──
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
# Usa claves TEST (sk_test_...) en desarrollo y LIVE (sk_live_...) en producción
STRIPE_SECRET_KEY=
# Webhook secret: créalo en https://dashboard.stripe.com/webhooks
# Endpoint a registrar: POST https://tudominio.com/api/payments/stripe/webhook
# Eventos requeridos: checkout.session.completed, customer.subscription.deleted, customer.subscription.paused
STRIPE_WEBHOOK_SECRET=

# ── Pagos — MercadoPago (LATAM: AR, BR, CL, CO, MX, PE, UY) ──
# Obtén tu Access Token en: https://www.mercadopago.com/developers/panel/credentials
# Usa credenciales TEST en desarrollo y PROD en producción
MP_ACCESS_TOKEN=
# Secret opcional para verificación adicional de webhooks
MP_WEBHOOK_SECRET=
